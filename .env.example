# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.

# Vercel deployment URLs — used to link between environments in the app.
# Leave blank for local dev. Set in each Vercel project's Environment Variables.
VITE_VERCEL_URL=

# Google Analytics 4 measurement ID (Admin → Data streams → Web → Measurement ID).
# Leave blank locally so dev traffic is not counted. Set in Vercel production env vars.
VITE_GA_MEASUREMENT_ID=

# Site password for Vercel Edge Middleware (middleware.ts + /api/auth).
# Set the same value in Vercel → Project → Settings → Environment Variables.
# Leave unset locally to skip the login gate during `npm run dev`.
SITE_PASSWORD=
